extends "res://ui/settings/settings.gd"
## Тестовый двойник экрана настроек. Живёт только ради одного места —
## Родительской Защиты перед конструктором наборов.
##
## Единственное отличие от боевого settings.gd: open_constructor() здесь НЕ
## меняет сцену, а считает вызовы. Настоящий метод зовёт
## get_tree().change_scene_to_file(), а валидатор сам является current_scene,
## то есть такой вызов уничтожил бы валидатор целиком — и проверка «колбэк
## вызван ровно один раз» стала бы непроверяемой в принципе.
##
## Сцена подставляется ДО add_child(), чтобы _ready() отработал ровно один раз
## и уже под новым скриптом: если подменить скрипт после add_child() и звать
## _ready() вручную, Godot сыплет «Signal ... already connected», и валидатор
## захлебнётся чужими ошибками.
##
## Сам шов «кнопка -> Защита -> метод» при этом проверяется по-настоящему:
## и объект, и имя метода в _on_success_callback берутся из живой Защиты,
## поднятой этим экраном. Подмена происходит уже ПОСЛЕ того, как шов зафиксирован.

## Счётчик вызовов open_constructor().
var constructor_calls: int = 0


## Замена боевого перехода. Всё, что проверяется про Защиту, живёт ДО этого
## метода, поэтому подмена ничего не ослабляет — она лишь не даёт тесту
## сменить сцену на настоящей.
func open_constructor() -> void:
	constructor_calls += 1


## Куда пошёл бы боевой open_constructor(). Отдельный метод, потому что
## SET_LIST_SCENE — константа класса, а читать её из валидатора напрямую нельзя
## без жёсткой зависимости теста от внутреннего имени.
func constructor_target() -> String:
	return SET_LIST_SCENE
