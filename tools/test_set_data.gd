class_name TestSetData
extends RefCounted
## Данные собственного тестового набора: 33 новых слова и пути к их медиа.
##
## Слова не пересекаются ни с одним из пяти встроенных наборов. Это и есть
## смысл набора: родитель должен видеть, что применился его набор, а не копия
## набора 1. Ударение хранится в слове, потому что так его читает TTS и так
## его показывает игра; картинки и озвучка генерируются без него.
##
## Только данные: ни загрузки, ни записи. Пути собираются из ASSET_DIR, чтобы
## инструмент и валидатор не дублировали строки каталога.

const ASSET_DIR := "res://tools/test_set_assets"

const WORDS := {
	"А": "Альбо́м",
	"Б": "Бу́блик",
	"В": "Ви́шня",
	"Г": "Гнездо́",
	"Д": "Ды́ня",
	"Е": "Единоро́г",
	"Ё": "Ё́мкость",
	"Ж": "Жасми́н",
	"З": "Зе́ркало",
	"И": "Имби́рь",
	"Й": "Йо́га",
	"К": "Коза́",
	"Л": "Ло́дка",
	"М": "Моро́женое",
	"Н": "Но́ра",
	"О": "О́блако",
	"П": "Помидо́р",
	"Р": "Ре́па",
	"С": "Су́мка",
	"Т": "Ту́ча",
	"У": "Укро́п",
	"Ф": "Фона́рь",
	"Х": "Хо́бот",
	"Ц": "Ци́фра",
	"Ч": "Чесно́к",
	"Ш": "Шмель",
	"Щ": "Щаве́ль",
	"Ъ": "Разъе́зд",
	"Ы": "Бык",
	"Ь": "Лось",
	"Э": "Эта́ж",
	"Ю": "Ю́нга",
	"Я": "Я́ма",
}


## Слово буквы или "" для неизвестной буквы. Регистр не важен.
static func get_word(letter: String) -> String:
	return str(WORDS.get(letter.to_upper(), ""))


## PNG-карточка буквы в res://.
static func image_path(letter: String) -> String:
	return ASSET_DIR.path_join(letter.to_upper() + ".png")


## WAV-озвучка буквы в res://.
static func audio_path(letter: String) -> String:
	return ASSET_DIR.path_join(letter.to_upper() + ".wav")
