class_name LetterTranslit
extends RefCounted
## Транслитерация русских букв в ASCII для имён файлов в user://.
##
## В res:// кириллица в именах файлов работает (в проекте есть а_letter_tts.wav),
## но user:// в вебе — это MEMFS поверх IndexedDB, и поведение кодировки пути
## там не гарантировано. Поэтому имена пользовательских файлов ASCII-ные.
## Статический класс: состояния нет, только таблица и чистая функция.

## Раскладка кириллицы. Ключ — одна заглавная буква, значение — ASCII-имя.
const MAP := {
	"А": "a", "Б": "b", "В": "v", "Г": "g", "Д": "d", "Е": "e", "Ё": "yo",
	"Ж": "zh", "З": "z", "И": "i", "Й": "y", "К": "k", "Л": "l", "М": "m",
	"Н": "n", "О": "o", "П": "p", "Р": "r", "С": "s", "Т": "t", "У": "u",
	"Ф": "f", "Х": "h", "Ц": "ts", "Ч": "ch", "Ш": "sh", "Щ": "sch",
	"Ъ": "q", "Ы": "y", "Ь": "soft", "Э": "e", "Ю": "yu", "Я": "ya",
}

## Заглушка для не-букв, чтобы имя файла никогда не оказалось пустым.
const FALLBACK := "_"


## Возвращает ASCII-имя для буквы. Регистр игнорируется: и "А", и "а" -> "a".
## Не-буква (цифра, пробел, пустая строка, несколько символов) -> FALLBACK.
static func to_ascii(letter: String) -> String:
	if letter.length() != 1:
		return FALLBACK
	var key := letter.to_upper()
	if MAP.has(key):
		return str(MAP[key])
	return FALLBACK
