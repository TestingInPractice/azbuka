; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[android]

permissions=PackedStringArray("android.permission.RECORD_AUDIO")

[application]

config/name="Азбука"
config/description="Russian alphabet learning game"
run/main_scene="res://screens/start_screen/start_screen.tscn"
config/features=PackedStringArray("4.6")
config/dev_mode=true

[audio]

driver/enable_input=true

[autoload]

GameLogger="*res://autoload/logger.gd"
AlphabetData="*res://autoload/alphabet_data.gd"
ThemeManager="*res://autoload/theme_manager.gd"
ProgressManager="*res://autoload/progress_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
Global="*res://autoload/global.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/initial_width=540
window/size/initial_height=960

[ios]

permissions=PackedStringArray("Microphone")

[rendering]

renderer/rendering_method="gl_compatibility"
