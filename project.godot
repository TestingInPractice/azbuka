; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[android]

permissions=PackedStringArray("android.permission.RECORD_AUDIO")

[application]

config/name="Азбука"
config/description="Детская развивающая игра для изучения русского алфавита"
run/main_scene="res://ui/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.6")
config/dev_mode=true

[audio]

driver/enable_input=true
bus/default_bus_layout="res://assets/audio/default_bus_layout.tres"

[autoload]

GameLogger="*res://addons/game_logger.gd"
AlphabetData="*res://systems/alphabet_data.gd"
ThemeManager="*res://addons/theme_manager.gd"
ProgressManager="*res://systems/progress_manager.gd"
AudioManager="*res://addons/audio_manager.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=2340
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/initial_width=540
window/size/initial_height=1170

[rendering]

renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.960784, 0.941176, 0.909804, 1)
